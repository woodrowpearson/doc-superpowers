#!/usr/bin/env bash
# doc-superpowers hook v1 — installed __INSTALL_DATE__ — release reminder
# DO NOT EDIT — managed by doc-superpowers hooks installer
#
# git feeds this hook one "<local ref> <local oid> <remote ref> <remote oid>"
# line per ref being pushed. For each branch pushed (not a tag, not a
# deletion), counts the commits since the newest tag it contains, and past 5
# suggests drafting release notes. Never blocks.
# The skill being absent is silent. DOC_SUPERPOWERS_QUIET=1 silences it;
# DOC_SUPERPOWERS_SKIP=1 turns it off. DOC_SUPERPOWERS_ADVICE (else
# .claude/doc-superpowers/hooks.conf's advice) replaces or drops the
# '/doc-superpowers release' it suggests.
#
# With docs/spec-claims/ present, a claims leg (advisory) runs for every
# branch pushed, tagged or not: `doc-tools.sh claims run --planes-of` over the
# commits the push adds (<remote oid>..<local oid>; from the merge-base with
# the config's base, else origin/main, for a new branch, and when the remote
# oid is not an ancestor of the local one: a force-push, or a remote commit
# not fetched), and, for the first pushed ref whose oid is HEAD's commit
# (attest judges HEAD; once per push), `claims attest --plan` for each plan
# with gate records in docs/spec-claims/gates/<stem>/ but no final.json. Each
# branch the leg runs for prints
# "claims (advisory): <n> red, <m> indeterminate" (zero counts included) and
# the finding lines; the exit code never changes.
# DOC_SUPERPOWERS_CLAIMS_SKIP=1 turns the leg off.

# The shared settings region below is every git hook's; this one runs no
# freshness check, so its watchdog, budget and _why go unused.
# shellcheck disable=SC2329,SC2154
[[ "${DOC_SUPERPOWERS_SKIP:-}" == "1" ]] && exit 0
[[ "${DOC_SUPERPOWERS_QUIET:-}" == "1" ]] && exit 0

[[ -n "${DOC_TOOLS:-}" ]] || DOC_TOOLS=$(__DOC_TOOLS_RESOLVE__)
[[ -f "$DOC_TOOLS" ]] || exit 0

# >>> shared hook settings: one text in every git hook and in hook-lib.sh (test-hooks.sh pins the copies) >>>
# _hook_conf <key>: <key>'s value in .claude/doc-superpowers/hooks.conf (a
# "key = value" file: # comments, the last line for a key wins), "" when
# unset. Read by awk, never sourced; relative to the repository top, where
# every hook runs. No file, no process.
_hook_conf() {
  [ -f .claude/doc-superpowers/hooks.conf ] || return 0
  awk -v k="$1" '
    /^[ \t]*#/ { next }
    { i = index($0, "="); if (i == 0) next
      key = substr($0, 1, i - 1); gsub(/^[ \t]+|[ \t\r]+$/, "", key)
      if (key != k) next
      v = substr($0, i + 1); gsub(/^[ \t]+|[ \t\r]+$/, "", v); val = v; seen = 1 }
    END { if (seen) print val }' .claude/doc-superpowers/hooks.conf 2>/dev/null
}

# _advice <action>: the command the hooks' advice names for <action>:
# '/doc-superpowers <action>' by default; "" when DOC_SUPERPOWERS_ADVICE
# (else hooks.conf's advice key) is off; any other value is a template, its
# every {action} replaced by <action> (on or default: the default).
_advice() {
  local t="${DOC_SUPERPOWERS_ADVICE:-}"
  [ -n "$t" ] || t=$(_hook_conf advice)
  t="${t//[$'\n\r']/ }"
  case "$t" in
    "" | on | default) printf '/doc-superpowers %s' "$1" ;;
    off) ;;
    *) printf '%s' "${t//\{action\}/$1}" ;;
  esac
}

# _hook_budget: the git hooks' freshness-check budget in seconds:
# DOC_SUPERPOWERS_HOOK_BUDGET, else hooks.conf's hook_budget, else 20; 0 is
# no budget, and a value that is not digits reads as the default. Past a day
# (86400) — more than six digits once leading zeros are dropped, or a value
# sleep cannot take — it reads as 0, no budget: never a watchdog that fires
# at once.
_hook_budget() {
  local b="${DOC_SUPERPOWERS_HOOK_BUDGET:-}"
  [ -n "$b" ] || b=$(_hook_conf hook_budget)
  case "$b" in
    "" | *[!0-9]*) b=20 ;;
  esac
  b="${b#"${b%%[!0]*}"}"
  if [ -z "$b" ] || [ "${#b}" -gt 6 ] || [ "$b" -gt 86400 ]; then
    b=0
  fi
  printf '%s' "$b"
}

# _bounded <function>: run <function> in its own process group, its stdout to
# $work/out and stderr to $work/err, with a watchdog that, after BUDGET
# seconds, first leaves a marker and then kills the whole group. Neither job
# keeps the hook's stdout open. The watchdog is always killed and reaped
# before the verdict: whether it fired is read from the marker, never from
# whether it is still alive (it can be alive between its kill and its exit).
# A watchdog whose sleep fails never fires. Returns <function>'s status, or
# 124 when it was cut short. BUDGET 0: no watchdog. The hook interrupted
# (INT, TERM, HUP) while the check runs kills both groups (the check's own
# group is out of reach of the terminal's ^C), then dies of that signal
# (128+n).
_bounded() {
  local pid="" wd="" rc=0
  if [ "${BUDGET:-0}" = 0 ]; then
    "$1" >"$work/out" 2>"$work/err" </dev/null || rc=$?
    return "$rc"
  fi
  trap '_bounded_stop HUP 1' HUP
  trap '_bounded_stop INT 2' INT
  trap '_bounded_stop TERM 15' TERM
  set -m
  "$1" >"$work/out" 2>"$work/err" </dev/null &
  pid=$!
  ( sleep "$BUDGET" && { : > "$work/timedout"; kill -TERM -- "-$pid" 2>/dev/null; } ) >/dev/null 2>&1 </dev/null &
  wd=$!
  set +m
  wait "$pid" 2>/dev/null || rc=$?
  trap - HUP INT TERM
  kill -TERM -- "-$wd" 2>/dev/null
  wait "$wd" 2>/dev/null
  # A check that finished cleanly is used even if the watchdog fired after it.
  if [[ "$rc" != 0 && -e "$work/timedout" ]]; then
    rc=124
  fi
  return "$rc"
}

# _bounded_stop <signal> <number>: _bounded's handler: kill the check's and
# the watchdog's groups (_bounded's pid and wd), then re-raise the signal
# (the EXIT trap still runs), exiting 128+<number> should it return.
# shellcheck disable=SC2329  # run by _bounded's traps
_bounded_stop() {
  trap - HUP INT TERM
  [ -z "${pid:-}" ] || kill -TERM -- "-$pid" 2>/dev/null
  [ -z "${wd:-}" ] || kill -TERM -- "-$wd" 2>/dev/null
  kill -s "$1" "$$"
  exit $((128 + $2))
}

# Why a check failed: the first ERROR: line of $work/err, else its first
# other non-NOTE line, without the ERROR: prefix or a final period.
_why() {
  local why
  why=$(awk '/^ERROR: / { print; e = 1; exit } NF && !/^NOTE: / && o == "" { o = $0 } END { if (!e) print o }' "$work/err")
  why="${why#ERROR: }"
  printf '%s' "${why%.}"
}
# <<< shared hook settings <<<

# --- Spec claims (advisory) ---
# Every doc-tools call reads /dev/null: the ref lines are the loop's stdin.
# _claims_call <verb> <args…>: runs the verb and adds its verdict to the
# tally — claims_red (findings), claims_ind (indeterminate rows, or 1 when it
# could not run) and claims_lines.
_claims_call() {
  local out tally why
  out=$("$DOC_TOOLS" claims "$@" </dev/null 2>/dev/null)
  tally=$(jq -r --arg verb "$1" 'if type == "object" and (.exit | type) == "number" then
      "\((.findings // []) | length) \(((.indeterminate // []) | length) + (if .error then 1 else 0 end))",
      (.findings[]?, .indeterminate[]?
        | "  \(.check)\(if .claim then " \(.claim)" else "" end): \(.message // .reason)"),
      (.error // empty | "  claims \($verb) could not run: \(.)")
    else error("no verdict") end' <<<"$out" 2>/dev/null)
  if [[ -z "$tally" ]]; then
    why=$("$DOC_TOOLS" claims "$@" </dev/null 2>&1 >/dev/null | awk '/^ERROR: / { sub(/^ERROR: /, ""); print; exit }')
    why="${why%.}"
    tally="0 1"$'\n'"  claims $1 could not run: ${why:-no verdict}"
  fi
  claims_red=$((claims_red + ${tally%% *}))
  tally=${tally#* }
  claims_ind=$((claims_ind + ${tally%%$'\n'*}))
  [[ "$tally" == *$'\n'* ]] && claims_lines+="${tally#*$'\n'}"$'\n'
  return 0
}
# _claims_push <local oid> <remote oid>
_claims_push() {
  local range base mb head dir plan stem
  claims_red=0 claims_ind=0 claims_lines=""
  # A new branch (null remote oid), or a remote oid that is not an ancestor
  # of the local one (a force-push, or not fetched): from the merge-base.
  range=""
  case "$2" in
    *[!0]*) git merge-base --is-ancestor "$2" "$1" 2>/dev/null && range="$2..$1" ;;
  esac
  if [[ -z "$range" ]]; then
    base=$(jq -r '.base | strings' docs/spec-claims/config.json 2>/dev/null)
    [[ -n "$base" ]] || base=origin/main
    # Unresolvable: doc-tools reports the <base>...<oid> range it is given.
    if mb=$(git merge-base "$1" "$base" 2>/dev/null); then range="$mb..$1"; else range="$base...$1"; fi
  fi
  _claims_call run --planes-of "$range"
  head=$(git rev-parse -q --verify HEAD 2>/dev/null)
  if [[ "$1" == "$head" && "$claims_attested" != 1 ]]; then
    claims_attested=1
    for dir in docs/spec-claims/gates/*/; do
      [[ -d "$dir" && ! -e "${dir}final.json" ]] || continue
      plan=$(cat "$dir"chunk-*.json 2>/dev/null | jq -rs 'map(.plan? | strings) | first // empty' 2>/dev/null)
      stem=${plan##*/}
      stem=${stem%.*}
      dir=${dir%/}
      [[ -n "$plan" && -f "$plan" && "$stem" == "${dir##*/}" ]] || continue
      _claims_call attest --plan "$plan"
    done
  fi
  echo ""
  echo "doc-superpowers: claims (advisory): $claims_red red, $claims_ind indeterminate"
  printf '%s' "$claims_lines"
  echo ""
}
# attest judges HEAD: run once per push, for the first ref pushing HEAD's oid.
claims_attested=0
# The release reminder's command ("" when the advice is off).
adv=$(_advice release)

while read -r local_ref local_oid remote_ref remote_oid _ || [[ -n "${local_ref:-}" ]]; do
  case "$local_ref" in
    refs/tags/*) continue ;;
  esac
  # A deletion pushes the null object id (all zeros).
  case "$local_oid" in
    *[!0]*) ;;
    *) continue ;;
  esac
  if [[ -d docs/spec-claims && "${DOC_SUPERPOWERS_CLAIMS_SKIP:-}" != "1" ]]; then
    _claims_push "$local_oid" "${remote_oid:-}" </dev/null
  fi
  latest_tag=$(git describe --tags --abbrev=0 "$local_oid" 2>/dev/null) || continue
  [[ -n "$latest_tag" ]] || continue
  commit_count=$(git rev-list --count "${latest_tag}..${local_oid}" 2>/dev/null) || continue
  [[ "$commit_count" -le 5 ]] && continue
  echo ""
  echo "doc-superpowers: $commit_count commits since $latest_tag on ${remote_ref#refs/heads/}"
  [[ -z "$adv" ]] || echo "  Consider running '$adv' to draft release notes."
  echo ""
done

exit 0
