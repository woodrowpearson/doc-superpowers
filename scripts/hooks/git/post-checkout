#!/usr/bin/env bash
# doc-superpowers hook v1 — installed __INSTALL_DATE__
# DO NOT EDIT — managed by doc-superpowers hooks installer
#
# On a branch switch, reports the docs stale or missing on the new branch,
# scoped to the files that differ between the two revisions ($1, $2; both
# sides of a rename). File checkouts ($3=0) and unknown revisions (a clone's
# null previous HEAD) are silent, as is the skill or the doc-index being
# absent; the check failing prints one line on stderr. Never blocks.
# DOC_SUPERPOWERS_QUIET=1 silences it; DOC_SUPERPOWERS_SKIP=1 turns it off.

[[ "${DOC_SUPERPOWERS_SKIP:-}" == "1" ]] && exit 0
[[ "${DOC_SUPERPOWERS_QUIET:-}" == "1" ]] && exit 0

# Only fire on branch switches ($3=1), not file checkouts ($3=0)
[[ "${3:-1}" == "0" ]] && exit 0

DOC_TOOLS="${DOC_TOOLS:-$(printf '%s\n' __DOC_TOOLS_PARENT__/*/scripts/doc-tools.sh | sort -V | tail -1)}"
[[ -f "$DOC_TOOLS" ]] || exit 0
[[ -f docs/.doc-index.json ]] || exit 0

_fail() {
  echo "doc-superpowers: post-checkout: cannot check doc freshness: $1 — check skipped" >&2
  exit 0
}

# Scope the check to the files that differ between the two revisions: a
# full-index walk here would freeze the terminal on a large index.
changed=$(git -c core.quotePath=false diff --name-only --no-renames "${1:-}" "${2:-}" 2>/dev/null)
[[ -z "$changed" ]] && exit 0

_check() { printf '%s\n' "$changed" | "$DOC_TOOLS" check-freshness --code-refs-from -; }
if ! result=$(_check 2>/dev/null); then
  why=$(_check 2>&1 >/dev/null | awk 'NF { print; exit }')
  why="${why#ERROR: }"
  why="${why%.}"
  _fail "${why:-doc-tools.sh check-freshness failed}"
fi

report=$(jq -r --arg move "  Run 'doc-tools.sh move-entry <old> <new>' if it was renamed, or 'remove-entry'/'deprecate-entry' to clean up." '
  [.docs | to_entries[] | select(.value.status == "stale") | .key] as $s
  | [.docs | to_entries[] | select(.value.status == "missing") | .key] as $m
  | (if ($s | length) > 0 then
       "doc-superpowers: \($s | length) stale doc(s) on this branch",
       "  \($s | join(", "))",
       "  Run '\''/doc-superpowers audit'\'' to review."
     else empty end),
    (if ($m | length) > 0 then
       "doc-superpowers: \($m | length) indexed doc(s) missing from disk",
       "  \($m | join(", "))",
       $move
     else empty end)
' <<<"$result" 2>/dev/null) || _fail "cannot read the freshness report"
[[ -z "$report" ]] && exit 0

echo ""
printf '%s\n' "$report"
echo ""
exit 0
