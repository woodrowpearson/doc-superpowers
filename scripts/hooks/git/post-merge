#!/usr/bin/env bash
# doc-superpowers hook v1 — installed __INSTALL_DATE__
# DO NOT EDIT — managed by doc-superpowers hooks installer
#
# Reports the docs a merge (or pull) left stale or missing, scoped to the files
# it changed (ORIG_HEAD..HEAD, both sides of a rename). Never blocks.
# The skill or the doc-index being absent, or no ORIG_HEAD, is silent; the
# check failing prints one line on stderr. DOC_SUPERPOWERS_QUIET=1 silences it;
# DOC_SUPERPOWERS_SKIP=1 turns it off.

[[ "${DOC_SUPERPOWERS_SKIP:-}" == "1" ]] && exit 0
[[ "${DOC_SUPERPOWERS_QUIET:-}" == "1" ]] && exit 0

[[ -n "${DOC_TOOLS:-}" ]] || DOC_TOOLS=$(__DOC_TOOLS_RESOLVE__)
[[ -f "$DOC_TOOLS" ]] || exit 0
[[ -f docs/.doc-index.json ]] || exit 0

_fail() {
  echo "doc-superpowers: post-merge: cannot check doc freshness: $1 — check skipped" >&2
  exit 0
}

# Scope the check to the files this merge brought in: a full-index walk here
# would freeze the terminal on a large index.
changed=$(git -c core.quotePath=false diff --name-only --no-renames ORIG_HEAD HEAD 2>/dev/null)
[[ -z "$changed" ]] && exit 0

_check() { printf '%s\n' "$changed" | "$DOC_TOOLS" check-freshness --code-refs-from -; }
if ! result=$(_check 2>/dev/null); then
  why=$(_check 2>&1 >/dev/null | awk '/^ERROR: / { print; e = 1; exit } NF && !/^NOTE: / && o == "" { o = $0 } END { if (!e) print o }')
  why="${why#ERROR: }"
  why="${why%.}"
  _fail "${why:-doc-tools.sh check-freshness failed}"
fi

report=$(jq -r --arg move "  Run 'doc-tools.sh move-entry <old> <new>' if it was renamed, or 'remove-entry'/'deprecate-entry' to clean up." '
  [.docs | to_entries[] | select(.value.status == "stale")] as $s
  | [.docs | to_entries[] | select(.value.status == "missing")] as $m
  | (if ($s | length) > 0 then
       "doc-superpowers: \($s | length) doc(s) became stale after merge",
       ($s[] | "  \(.key) — \(.value.reason // "stale")"
         + (if ((.value.code_refs_changed // []) | length) > 0 then ": \(.value.code_refs_changed | join(", "))" else "" end)),
       "  Run '\''/doc-superpowers audit'\'' to review."
     else empty end),
    (if ($m | length) > 0 then
       "doc-superpowers: \($m | length) indexed doc(s) missing from disk",
       ($m[] | "  \(.key)"),
       $move
     else empty end)
' <<<"$result" 2>/dev/null) || _fail "cannot read the freshness report"
[[ -z "$report" ]] && exit 0

echo ""
printf '%s\n' "$report"
echo ""
exit 0
