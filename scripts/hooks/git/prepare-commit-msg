#!/usr/bin/env bash
# doc-superpowers hook v1 — installed __INSTALL_DATE__
# DO NOT EDIT — managed by doc-superpowers hooks installer
#
# For a commit whose message is written in the editor, lists the docs already
# stale in this commit as comment lines, which git strips from the message.
# Only then: with -m, -F, -C/-c, --amend --no-edit, a merge or a squash ($2 is
# message, commit, merge or squash) git keeps comment lines, so they would be
# committed. The check is pre-commit's (staged tree, staged paths); if it
# cannot run, one comment line says so. DOC_SUPERPOWERS_QUIET=1 or SKIP=1:
# nothing is added.

COMMIT_MSG_FILE="${1:-}"
COMMIT_SOURCE="${2:-}"

[[ "${DOC_SUPERPOWERS_SKIP:-}" == "1" ]] && exit 0
[[ "${DOC_SUPERPOWERS_QUIET:-}" == "1" ]] && exit 0
[[ -n "$COMMIT_MSG_FILE" ]] || exit 0
case "$COMMIT_SOURCE" in
  ''|template) ;;
  *) exit 0 ;;
esac

# Comment lines are stripped only under the default cleanup, and git must
# recognize them: an unknown ("auto") comment character leaves nothing to add.
cleanup=$(git config commit.cleanup 2>/dev/null)
case "${cleanup:-default}" in
  default|strip) ;;
  *) exit 0 ;;
esac
cc=$(git config core.commentString 2>/dev/null || git config core.commentChar 2>/dev/null)
case "${cc:-#}" in
  auto) exit 0 ;;
esac
cc="${cc:-#}"

[[ -n "${DOC_TOOLS:-}" ]] || DOC_TOOLS=$(__DOC_TOOLS_RESOLVE__)
[[ -f "$DOC_TOOLS" ]] || exit 0
[[ -f docs/.doc-index.json ]] || exit 0

_fail() {
  printf '\n%s doc-superpowers: cannot check doc freshness: %s\n' "$cc" "$1" >> "$COMMIT_MSG_FILE"
  exit 0
}

staged=$(git -c core.quotePath=false diff --cached --name-only --no-renames 2>/dev/null) \
  || _fail "git diff --cached failed"
[[ -z "$staged" ]] && exit 0
tree=$(git write-tree 2>/dev/null) || _fail "git write-tree failed"

_check() { printf '%s\n' "$staged" | "$DOC_TOOLS" check-freshness --tree "$tree" --code-refs-from -; }
if ! result=$(_check 2>/dev/null); then
  why=$(_check 2>&1 >/dev/null | awk '/^ERROR: / { print; e = 1; exit } NF && !/^NOTE: / && o == "" { o = $0 } END { if (!e) print o }')
  why="${why#ERROR: }"
  why="${why%.}"
  _fail "${why:-doc-tools.sh check-freshness failed}"
fi

block=$(jq -r --arg cc "$cc" '
  [.docs | to_entries[] | select(.value.status == "stale")] as $s
  | if ($s | length) == 0 then empty else
      "\($cc) Doc freshness: \($s | length) doc(s) already stale in this commit (their code changed since they were verified):",
      ($s[] | "\($cc)   \(.key)"
        + (if .value.reason then " (\(.value.reason)"
             + (if ((.value.code_refs_changed // []) | length) > 0 then ": \(.value.code_refs_changed | join(", "))" else "" end)
             + ")" else "" end)),
      "\($cc) Update them with /doc-superpowers update, then re-verify each (doc-tools.sh update-index <doc>)."
    end
' <<<"$result" 2>/dev/null) || _fail "cannot read the freshness report"
[[ -z "$block" ]] && exit 0

printf '\n%s\n' "$block" >> "$COMMIT_MSG_FILE"
exit 0
