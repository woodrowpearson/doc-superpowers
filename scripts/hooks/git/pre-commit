#!/usr/bin/env bash
# doc-superpowers hook v1 — installed __INSTALL_DATE__
# DO NOT EDIT — managed by doc-superpowers hooks installer
#
# Reports the docs this commit leaves stale. The check runs on the staged tree
# (`git write-tree`: exactly what is being committed, also for `commit -a` and
# a pathspec commit, whose temporary index git hands the hook), scoped to the
# staged paths — both sides of a rename.
# DOC_SUPERPOWERS_STRICT=1 blocks the commit instead of warning;
# DOC_SUPERPOWERS_QUIET=1 silences the output, never the exit code;
# DOC_SUPERPOWERS_SKIP=1 bypasses the hook.
# The skill or the doc-index being absent is silent. The check failing (jq
# missing from PATH, a corrupt index) prints one line on stderr, and blocks
# only under STRICT.

[[ "${DOC_SUPERPOWERS_SKIP:-}" == "1" ]] && exit 0

# --- Path resolution (DOC_TOOLS is replaced at install time) ---
# When running from test harness or directly, DOC_TOOLS env var overrides.
DOC_TOOLS="${DOC_TOOLS:-$(printf '%s\n' __DOC_TOOLS_PARENT__/*/scripts/doc-tools.sh | sort -V | tail -1)}"

# --- Graceful degradation: tooling absent ---
[[ -f "$DOC_TOOLS" ]] || exit 0
[[ -f docs/.doc-index.json ]] || exit 0

_quiet() { [[ "${DOC_SUPERPOWERS_QUIET:-}" == "1" ]]; }
_strict() { [[ "${DOC_SUPERPOWERS_STRICT:-}" == "1" ]]; }

# --- Tooling failing: one line; blocks only under STRICT ---
_fail() {
  if _strict; then
    _quiet || echo "doc-superpowers: pre-commit: cannot check doc freshness: $1 — commit blocked (DOC_SUPERPOWERS_STRICT=1; DOC_SUPERPOWERS_SKIP=1 bypasses)" >&2
    exit 1
  fi
  _quiet || echo "doc-superpowers: pre-commit: cannot check doc freshness: $1 — check skipped" >&2
  exit 0
}

# --- The staged paths and the staged tree ---
staged=$(git -c core.quotePath=false diff --cached --name-only --no-renames 2>/dev/null) \
  || _fail "git diff --cached failed"
[[ -z "$staged" ]] && exit 0
tree=$(git write-tree 2>/dev/null) || _fail "git write-tree failed"

# --- Check freshness in the staged tree, scoped to the staged paths ---
_check() { printf '%s\n' "$staged" | "$DOC_TOOLS" check-freshness --tree "$tree" --code-refs-from -; }
if ! result=$(_check 2>/dev/null); then
  why=$(_check 2>&1 >/dev/null | awk 'NF { print; exit }')
  why="${why#ERROR: }"
  why="${why%.}"
  _fail "${why:-doc-tools.sh check-freshness failed}"
fi

# --- Parse results (line 1: "<stale> <missing>", then the report) ---
report=$(jq -r --arg move "  Run 'doc-tools.sh move-entry <old> <new>' if it was renamed, or 'remove-entry'/'deprecate-entry' to clean up." '
  [.docs | to_entries[] | select(.value.status == "stale")] as $s
  | [.docs | to_entries[] | select(.value.status == "missing")] as $m
  | "\($s | length) \($m | length)",
    (if ($s | length) > 0 then
       "doc-superpowers: \($s | length) stale doc(s) in this commit",
       ($s[] | "  \(.key) — \(.value.reason // "stale")"
         + (if ((.value.code_refs_changed // []) | length) > 0 then ": \(.value.code_refs_changed | join(", "))" else "" end)
         + (if ((.value.commits_behind // 0) > 0) then " (\(.value.commits_behind) commits behind)" else "" end))
     else empty end),
    (if ($m | length) > 0 then
       "doc-superpowers: \($m | length) indexed doc(s) missing from disk",
       ($m[] | "  \(.key)"),
       $move
     else empty end)
' <<<"$result" 2>/dev/null) || _fail "cannot read the freshness report"

counts=${report%%$'\n'*}
[[ "$counts" == "0 0" ]] && exit 0

# --- Report issues ---
if ! _quiet; then
  echo ""
  printf '%s\n' "${report#*$'\n'}"
  if _strict; then
    echo "  Commit blocked (DOC_SUPERPOWERS_STRICT=1). Run '/doc-superpowers update' to refresh, or DOC_SUPERPOWERS_SKIP=1 to bypass."
  else
    echo "  Run '/doc-superpowers update' to refresh, or DOC_SUPERPOWERS_SKIP=1 to bypass."
  fi
  echo ""
fi

# --- Exit code ---
_strict && exit 1
exit 0
