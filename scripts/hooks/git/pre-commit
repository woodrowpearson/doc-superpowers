#!/usr/bin/env bash
# doc-superpowers hook v1 — installed __INSTALL_DATE__
# DO NOT EDIT — managed by doc-superpowers hooks installer
#
# Reports the docs this commit leaves stale. The check runs on the staged tree
# (`git write-tree`: exactly what is being committed, also for `commit -a` and
# a pathspec commit, whose temporary index git hands the hook), scoped to the
# staged paths — both sides of a rename — plus every entry the staged
# doc-index adds (judged scoped to their own code refs). An indexed doc the
# commit leaves out is "not in this commit" when it is on disk (git add it),
# "missing from disk" when it is gone.
# The check gets DOC_SUPERPOWERS_HOOK_BUDGET seconds (else the hook_budget key
# of .claude/doc-superpowers/hooks.conf, else 20; 0: no budget): past that it
# is killed, with everything it started, and one line says "check skipped
# (budget)" — under STRICT the commit is blocked instead, as for a check that
# cannot run. DOC_SUPERPOWERS_ADVICE (else hooks.conf's advice key) replaces
# the '/doc-superpowers update' it advises: off drops it, any other text is
# used with {action} replaced.
# DOC_SUPERPOWERS_STRICT=1 blocks the commit instead of warning;
# DOC_SUPERPOWERS_QUIET=1 silences the output, never the exit code;
# DOC_SUPERPOWERS_SKIP=1 bypasses the hook.
# The skill or the doc-index being absent is silent. The check failing (jq
# missing from PATH, a corrupt index) prints one line on stderr, and blocks
# only under STRICT.
#
# With docs/spec-claims/ present, a claims leg runs first, with or without a
# doc-index: `doc-tools.sh claims validate --staged` checks the spec claims
# the staged change touches. A finding (exit 1) blocks the commit whatever
# STRICT says; an advisory is printed and the commit goes on; the check not
# running (exit 2 or 3, or a doc-tools.sh without the claims verb) prints one
# line on stderr, and blocks only under STRICT.
# DOC_SUPERPOWERS_CLAIMS_SKIP=1 bypasses that leg alone. Without
# docs/spec-claims/ the leg never runs.

[[ "${DOC_SUPERPOWERS_SKIP:-}" == "1" ]] && exit 0

# --- Path resolution ---
# $DOC_TOOLS overrides. Otherwise the program install.sh substituted runs: the
# newest version-named sibling's doc-tools.sh (plugin cache, numeric order), or
# the pinned path of a checkout install — the merge driver's rule.
[[ -n "${DOC_TOOLS:-}" ]] || DOC_TOOLS=$(__DOC_TOOLS_RESOLVE__)

# --- Graceful degradation: tooling absent ---
[[ -f "$DOC_TOOLS" ]] || exit 0

_quiet() { [[ "${DOC_SUPERPOWERS_QUIET:-}" == "1" ]]; }
_strict() { [[ "${DOC_SUPERPOWERS_STRICT:-}" == "1" ]]; }

# >>> shared hook settings: one text in every git hook and in hook-lib.sh (test-hooks.sh pins the copies) >>>
# _hook_conf <key>: <key>'s value in .claude/doc-superpowers/hooks.conf (a
# "key = value" file: # comments, the last line for a key wins), "" when
# unset. Read by awk, never sourced; relative to the repository top, where
# every hook runs. No file, no process.
_hook_conf() {
  [ -f .claude/doc-superpowers/hooks.conf ] || return 0
  awk -v k="$1" '
    /^[ \t]*#/ { next }
    { i = index($0, "="); if (i == 0) next
      key = substr($0, 1, i - 1); gsub(/^[ \t]+|[ \t\r]+$/, "", key)
      if (key != k) next
      v = substr($0, i + 1); gsub(/^[ \t]+|[ \t\r]+$/, "", v); val = v; seen = 1 }
    END { if (seen) print val }' .claude/doc-superpowers/hooks.conf 2>/dev/null
}

# _advice <action>: the command the hooks' advice names for <action>:
# '/doc-superpowers <action>' by default; "" when DOC_SUPERPOWERS_ADVICE
# (else hooks.conf's advice key) is off; any other value is a template, its
# every {action} replaced by <action> (on or default: the default).
_advice() {
  local t="${DOC_SUPERPOWERS_ADVICE:-}"
  [ -n "$t" ] || t=$(_hook_conf advice)
  t="${t//[$'\n\r']/ }"
  case "$t" in
    "" | on | default) printf '/doc-superpowers %s' "$1" ;;
    off) ;;
    *) printf '%s' "${t//\{action\}/$1}" ;;
  esac
}

# _hook_budget: the git hooks' freshness-check budget in seconds:
# DOC_SUPERPOWERS_HOOK_BUDGET, else hooks.conf's hook_budget, else 20; 0 is
# no budget, and a value that is not digits reads as the default.
_hook_budget() {
  local b="${DOC_SUPERPOWERS_HOOK_BUDGET:-}"
  [ -n "$b" ] || b=$(_hook_conf hook_budget)
  case "$b" in
    "" | *[!0-9]*) b=20 ;;
  esac
  printf '%s' "$((10#$b))"
}

# _bounded <function>: run <function> in its own process group, its stdout to
# $work/out and stderr to $work/err, with a watchdog that, after BUDGET
# seconds, first leaves a marker and then kills the whole group. Neither job
# keeps the hook's stdout open. The watchdog is always killed and reaped
# before the verdict: whether it fired is read from the marker, never from
# whether it is still alive (it can be alive between its kill and its exit).
# Returns <function>'s status, or 124 when it was cut short. BUDGET 0: no
# watchdog.
_bounded() {
  local pid wd rc=0
  if [ "${BUDGET:-0}" = 0 ]; then
    "$1" >"$work/out" 2>"$work/err" </dev/null || rc=$?
    return "$rc"
  fi
  set -m
  "$1" >"$work/out" 2>"$work/err" </dev/null &
  pid=$!
  ( sleep "$BUDGET"; : > "$work/timedout"; kill -TERM -- "-$pid" 2>/dev/null ) >/dev/null 2>&1 </dev/null &
  wd=$!
  set +m
  wait "$pid" 2>/dev/null || rc=$?
  kill -TERM -- "-$wd" 2>/dev/null
  wait "$wd" 2>/dev/null
  # A check that finished cleanly is used even if the watchdog fired after it.
  if [[ "$rc" != 0 && -e "$work/timedout" ]]; then
    rc=124
  fi
  return "$rc"
}

# Why a check failed: the first ERROR: line of $work/err, else its first
# other non-NOTE line, without the ERROR: prefix or a final period.
_why() {
  local why
  why=$(awk '/^ERROR: / { print; e = 1; exit } NF && !/^NOTE: / && o == "" { o = $0 } END { if (!e) print o }' "$work/err")
  why="${why#ERROR: }"
  printf '%s' "${why%.}"
}
# <<< shared hook settings <<<

# --- Spec claims: a finding blocks, whatever STRICT says ---
# stdin is /dev/null: no adapter the verb runs may read the hook's stdin.
if [[ -d docs/spec-claims && "${DOC_SUPERPOWERS_CLAIMS_SKIP:-}" != "1" ]]; then
  _claims() { "$DOC_TOOLS" claims validate --staged </dev/null; }
  # One line per row of the verdict's <findings|advisories>.
  _claims_lines() {
    jq -r --arg k "$1" '.[$k][]?
      | "doc-superpowers: claims: \(.check)\(if .claim then " \(.claim)" else "" end): \(.message)"' \
      <<<"$claims" 2>/dev/null
  }
  claims_rc=0
  claims=$(_claims 2>/dev/null) || claims_rc=$?
  case "$claims_rc" in
    0) _quiet || _claims_lines advisories ;;
    1)
      if ! _quiet; then
        _claims_lines findings
        echo "  Commit blocked (claims). Fix, or rule the direction — see references/spec-claims.md. DOC_SUPERPOWERS_CLAIMS_SKIP=1 bypasses."
      fi
      exit 1
      ;;
    *)
      # The verdict's error, else its first indeterminate reason, else (no
      # verdict: a doc-tools.sh older than the verb) the ERROR line on stderr.
      why=$(jq -r '.error // .indeterminate[0].reason // empty' <<<"$claims" 2>/dev/null)
      [[ -n "$why" ]] || why=$(_claims 2>&1 >/dev/null | awk '/^ERROR: / { sub(/^ERROR: /, ""); print; exit }')
      why="${why%.}"
      why="${why:-doc-tools.sh claims validate failed}"
      if _strict; then
        _quiet || echo "doc-superpowers: pre-commit: claims check could not run: $why — commit blocked (DOC_SUPERPOWERS_STRICT=1; DOC_SUPERPOWERS_CLAIMS_SKIP=1 bypasses)" >&2
        exit 1
      fi
      _quiet || echo "doc-superpowers: pre-commit: claims check could not run: $why — check skipped" >&2
      ;;
  esac
fi

[[ -f docs/.doc-index.json ]] || exit 0

# --- Tooling failing: one line; blocks only under STRICT ---
_fail() {
  if _strict; then
    _quiet || echo "doc-superpowers: pre-commit: cannot check doc freshness: $1 — commit blocked (DOC_SUPERPOWERS_STRICT=1; DOC_SUPERPOWERS_SKIP=1 bypasses)" >&2
    exit 1
  fi
  _quiet || echo "doc-superpowers: pre-commit: cannot check doc freshness: $1 — check skipped" >&2
  exit 0
}

# --- The staged paths and the staged tree ---
staged=$(git -c core.quotePath=false diff --cached --name-only --no-renames 2>/dev/null) \
  || _fail "git diff --cached failed"
[[ -z "$staged" ]] && exit 0
tree=$(git write-tree 2>/dev/null) || _fail "git write-tree failed"

BUDGET=$(_hook_budget)
work=$(mktemp -d "${TMPDIR:-/tmp}/doc-sp-pre-commit.XXXXXX") || _fail "mktemp failed"
trap 'rm -rf "$work"' EXIT

# --- The check, under the watchdog (_bounded): the report on stdout ---
# Scoped to the staged paths. That scope reaches a doc through its code refs
# only, so a commit that stages a new entry without its code (or without the
# doc) would pass unjudged: the added keys (the staged index's minus HEAD's)
# are judged too, scoped to their own code refs (a filter keeps every entry
# with a ref under a listed path, so each added entry is kept) — unscoped
# when one has no code ref, which no filter keeps — and their verdicts join
# the scoped ones. Each run's stderr is passed on only when that run fails,
# so the reason _why reads is the failing run's.
# shellcheck disable=SC2329  # run by _bounded
_check() {
  local result added refs wide
  result=$(printf '%s\n' "$staged" | "$DOC_TOOLS" check-freshness --tree "$tree" --code-refs-from - 2>"$work/err.scoped") \
    || { cat "$work/err.scoped" >&2; return 1; }
  if grep -qxF docs/.doc-index.json <<<"$staged"; then
    added=$( { git cat-file blob "$tree:docs/.doc-index.json" \
      && { git cat-file blob HEAD:docs/.doc-index.json 2>/dev/null || echo '{}'; }; } 2>/dev/null \
      | jq -cs '((.[0].docs // {}) | keys) - ((.[1].docs // {}) | keys)' 2>/dev/null) || added='[]'
    if [[ -n "$added" && "$added" != "[]" ]]; then
      refs=$(git cat-file blob "$tree:docs/.doc-index.json" 2>/dev/null | jq -r --argjson a "$added" '
        [.docs[$a[]] | [(.code_refs // []) | if type == "array" then .[] else empty end | strings | select(. != "")]]
        | if any(.[]; length == 0) then empty else .[][] end' 2>/dev/null) || refs=""
      if [[ -n "$refs" ]]; then
        wide=$(printf '%s\n' "$refs" | "$DOC_TOOLS" check-freshness --tree "$tree" --code-refs-from - 2>"$work/err.wide") \
          || { cat "$work/err.wide" >&2; return 1; }
      else
        wide=$("$DOC_TOOLS" check-freshness --tree "$tree" 2>"$work/err.wide") \
          || { cat "$work/err.wide" >&2; return 1; }
      fi
      result=$(printf '%s\n%s\n%s\n' "$added" "$result" "$wide" | jq -cs '
        (reduce .[0][] as $k ({}; .[$k] = true)) as $a
        | .[2].docs as $w
        | .[1] | .docs += ($w | with_entries(select($a[.key])))' 2>/dev/null) \
        || { echo "ERROR: cannot read the freshness report" >&2; return 1; }
    fi
  fi
  printf '%s\n' "$result"
}
rc=0
_bounded _check || rc=$?
if [[ "$rc" == 124 ]]; then
  # Under STRICT a check that cannot finish blocks, as one that cannot run.
  _strict && _fail "the check took longer than its ${BUDGET}s budget (DOC_SUPERPOWERS_HOOK_BUDGET=<seconds> changes it, 0 removes it)"
  # shellcheck disable=SC2016  # the command to run, printed as is
  _quiet || echo 'doc-superpowers: pre-commit: check skipped (budget): the doc freshness check took longer than '"${BUDGET}"'s; run '"'"'doc-tools.sh check-freshness --tree $(git write-tree)'"'"' by hand (DOC_SUPERPOWERS_HOOK_BUDGET=<seconds> changes the budget, 0 removes it)' >&2
  exit 0
fi
if [[ "$rc" != 0 ]]; then
  why=$(_why)
  _fail "${why:-doc-tools.sh check-freshness failed}"
fi
result=$(cat "$work/out")

# --- The docs the commit leaves out: on disk (unstaged) or gone ---
# (A JSON list on stdin, never argv: it can be index-sized.)
ondisk=""
while IFS= read -r doc; do
  [[ -n "$doc" && -e "$doc" ]] && ondisk+="$doc"$'\n'
done < <(jq -r '.docs | to_entries[] | select(.value.status == "missing") | .key' <<<"$result" 2>/dev/null)
ondisk=$(jq -Rsc 'split("\n") | map(select(. != ""))' <<<"$ondisk" 2>/dev/null) || _fail "cannot read the freshness report"

# --- Parse results (line 1: "<stale> <unstaged> <gone>", then the report) ---
report=$(printf '%s\n%s\n' "$result" "$ondisk" | jq -rs --arg move "  Run 'doc-tools.sh move-entry <old> <new>' if it was renamed, or 'remove-entry'/'deprecate-entry' to clean up." \
  --arg add "  The index this commit records lists them: stage each with 'git add <doc>'." '
  (reduce .[1][] as $k ({}; .[$k] = true)) as $d
  | .[0]
  | [.docs | to_entries[] | select(.value.status == "stale")] as $s
  | [.docs | to_entries[] | select(.value.status == "missing" and $d[.key])] as $u
  | [.docs | to_entries[] | select(.value.status == "missing" and ($d[.key] | not))] as $m
  | "\($s | length) \($u | length) \($m | length)",
    (if ($s | length) > 0 then
       "doc-superpowers: \($s | length) stale doc(s) in this commit",
       ($s[] | "  \(.key) — \(.value.reason // "stale")"
         + (if ((.value.code_refs_changed // []) | length) > 0 then ": \(.value.code_refs_changed | join(", "))" else "" end)
         + (if ((.value.commits_behind // 0) > 0) then " (\(.value.commits_behind) commits behind)" else "" end))
     else empty end),
    (if ($u | length) > 0 then
       "doc-superpowers: \($u | length) indexed doc(s) not in this commit (on disk, but not staged)",
       ($u[] | "  \(.key)"),
       $add
     else empty end),
    (if ($m | length) > 0 then
       "doc-superpowers: \($m | length) indexed doc(s) missing from disk",
       ($m[] | "  \(.key)"),
       $move
     else empty end)
' 2>/dev/null) || _fail "cannot read the freshness report"

counts=${report%%$'\n'*}
[[ "$counts" == "0 0 0" ]] && exit 0

# --- Report issues ---
if ! _quiet; then
  echo ""
  printf '%s\n' "${report#*$'\n'}"
  adv=$(_advice update)
  if [[ -n "$adv" ]]; then
    adv="Run '$adv' to refresh, or DOC_SUPERPOWERS_SKIP=1 to bypass."
  else
    adv="DOC_SUPERPOWERS_SKIP=1 bypasses."
  fi
  if _strict; then
    echo "  Commit blocked (DOC_SUPERPOWERS_STRICT=1). $adv"
  else
    echo "  $adv"
  fi
  echo ""
fi

# --- Exit code ---
_strict && exit 1
exit 0
