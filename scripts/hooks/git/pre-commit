#!/usr/bin/env bash
# doc-superpowers hook v1 — installed __INSTALL_DATE__
# DO NOT EDIT — managed by doc-superpowers hooks installer
#
# Reports the docs this commit leaves stale. The check runs on the staged tree
# (`git write-tree`: exactly what is being committed, also for `commit -a` and
# a pathspec commit, whose temporary index git hands the hook), scoped to the
# staged paths — both sides of a rename — plus every entry the staged
# doc-index adds. An indexed doc the commit leaves out is "not in this commit"
# when it is on disk (git add it), "missing from disk" when it is gone.
# DOC_SUPERPOWERS_STRICT=1 blocks the commit instead of warning;
# DOC_SUPERPOWERS_QUIET=1 silences the output, never the exit code;
# DOC_SUPERPOWERS_SKIP=1 bypasses the hook.
# The skill or the doc-index being absent is silent. The check failing (jq
# missing from PATH, a corrupt index) prints one line on stderr, and blocks
# only under STRICT.

[[ "${DOC_SUPERPOWERS_SKIP:-}" == "1" ]] && exit 0

# --- Path resolution ---
# $DOC_TOOLS overrides. Otherwise the program install.sh substituted runs: the
# newest version-named sibling's doc-tools.sh (plugin cache, numeric order), or
# the pinned path of a checkout install — the merge driver's rule.
[[ -n "${DOC_TOOLS:-}" ]] || DOC_TOOLS=$(__DOC_TOOLS_RESOLVE__)

# --- Graceful degradation: tooling absent ---
[[ -f "$DOC_TOOLS" ]] || exit 0
[[ -f docs/.doc-index.json ]] || exit 0

_quiet() { [[ "${DOC_SUPERPOWERS_QUIET:-}" == "1" ]]; }
_strict() { [[ "${DOC_SUPERPOWERS_STRICT:-}" == "1" ]]; }

# --- Tooling failing: one line; blocks only under STRICT ---
_fail() {
  if _strict; then
    _quiet || echo "doc-superpowers: pre-commit: cannot check doc freshness: $1 — commit blocked (DOC_SUPERPOWERS_STRICT=1; DOC_SUPERPOWERS_SKIP=1 bypasses)" >&2
    exit 1
  fi
  _quiet || echo "doc-superpowers: pre-commit: cannot check doc freshness: $1 — check skipped" >&2
  exit 0
}

# --- The staged paths and the staged tree ---
staged=$(git -c core.quotePath=false diff --cached --name-only --no-renames 2>/dev/null) \
  || _fail "git diff --cached failed"
[[ -z "$staged" ]] && exit 0
tree=$(git write-tree 2>/dev/null) || _fail "git write-tree failed"

# --- Check freshness in the staged tree, scoped to the staged paths ---
_check() { printf '%s\n' "$staged" | "$DOC_TOOLS" check-freshness --tree "$tree" --code-refs-from -; }
_why() {
  why=$("$@" 2>&1 >/dev/null | awk '/^ERROR: / { print; e = 1; exit } NF && !/^NOTE: / && o == "" { o = $0 } END { if (!e) print o }')
  why="${why#ERROR: }"
  why="${why%.}"
  _fail "${why:-doc-tools.sh check-freshness failed}"
}
result=$(_check 2>/dev/null) || _why _check

# --- Entries the staged index adds ---
# The scope above reaches a doc through its code refs only, so a commit that
# stages a new entry without its code (or without the doc) would pass
# unjudged: the added keys (the staged index's minus HEAD's) are judged
# unscoped, and their verdicts join the scoped ones.
if grep -qxF docs/.doc-index.json <<<"$staged"; then
  added=$( { git cat-file blob "$tree:docs/.doc-index.json" \
    && { git cat-file blob HEAD:docs/.doc-index.json 2>/dev/null || echo '{}'; }; } 2>/dev/null \
    | jq -cs '((.[0].docs // {}) | keys) - ((.[1].docs // {}) | keys)' 2>/dev/null) || added='[]'
  if [[ -n "$added" && "$added" != "[]" ]]; then
    _wide() { "$DOC_TOOLS" check-freshness --tree "$tree"; }
    wide=$(_wide 2>/dev/null) || _why _wide
    result=$(printf '%s\n%s\n%s\n' "$added" "$result" "$wide" | jq -cs '
      (reduce .[0][] as $k ({}; .[$k] = true)) as $a
      | .[2].docs as $w
      | .[1] | .docs += ($w | with_entries(select($a[.key])))' 2>/dev/null) \
      || _fail "cannot read the freshness report"
  fi
fi

# --- The docs the commit leaves out: on disk (unstaged) or gone ---
# (A JSON list on stdin, never argv: it can be index-sized.)
ondisk=""
while IFS= read -r doc; do
  [[ -n "$doc" && -e "$doc" ]] && ondisk+="$doc"$'\n'
done < <(jq -r '.docs | to_entries[] | select(.value.status == "missing") | .key' <<<"$result" 2>/dev/null)
ondisk=$(jq -Rsc 'split("\n") | map(select(. != ""))' <<<"$ondisk" 2>/dev/null) || _fail "cannot read the freshness report"

# --- Parse results (line 1: "<stale> <unstaged> <gone>", then the report) ---
report=$(printf '%s\n%s\n' "$result" "$ondisk" | jq -rs --arg move "  Run 'doc-tools.sh move-entry <old> <new>' if it was renamed, or 'remove-entry'/'deprecate-entry' to clean up." \
  --arg add "  The index this commit records lists them: stage each with 'git add <doc>'." '
  (reduce .[1][] as $k ({}; .[$k] = true)) as $d
  | .[0]
  | [.docs | to_entries[] | select(.value.status == "stale")] as $s
  | [.docs | to_entries[] | select(.value.status == "missing" and $d[.key])] as $u
  | [.docs | to_entries[] | select(.value.status == "missing" and ($d[.key] | not))] as $m
  | "\($s | length) \($u | length) \($m | length)",
    (if ($s | length) > 0 then
       "doc-superpowers: \($s | length) stale doc(s) in this commit",
       ($s[] | "  \(.key) — \(.value.reason // "stale")"
         + (if ((.value.code_refs_changed // []) | length) > 0 then ": \(.value.code_refs_changed | join(", "))" else "" end)
         + (if ((.value.commits_behind // 0) > 0) then " (\(.value.commits_behind) commits behind)" else "" end))
     else empty end),
    (if ($u | length) > 0 then
       "doc-superpowers: \($u | length) indexed doc(s) not in this commit (on disk, but not staged)",
       ($u[] | "  \(.key)"),
       $add
     else empty end),
    (if ($m | length) > 0 then
       "doc-superpowers: \($m | length) indexed doc(s) missing from disk",
       ($m[] | "  \(.key)"),
       $move
     else empty end)
' 2>/dev/null) || _fail "cannot read the freshness report"

counts=${report%%$'\n'*}
[[ "$counts" == "0 0 0" ]] && exit 0

# --- Report issues ---
if ! _quiet; then
  echo ""
  printf '%s\n' "${report#*$'\n'}"
  if _strict; then
    echo "  Commit blocked (DOC_SUPERPOWERS_STRICT=1). Run '/doc-superpowers update' to refresh, or DOC_SUPERPOWERS_SKIP=1 to bypass."
  else
    echo "  Run '/doc-superpowers update' to refresh, or DOC_SUPERPOWERS_SKIP=1 to bypass."
  fi
  echo ""
fi

# --- Exit code ---
_strict && exit 1
exit 0
